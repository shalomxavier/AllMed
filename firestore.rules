rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only Director (admin) and HR designations may add/edit/delete punch records
    function canManagePunches() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.designation in ['Director', 'HR'];
    }

    function canManageLeaves() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.designation in ['Director', 'HR'];
    }

    function canManageShifts() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.designation in ['Director', 'HR'];
    }

    // Allow authenticated users to read conversations
    match /whatsapp_conversations/{conversationId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Allow authenticated users to read messages
    match /whatsapp_messages/{messageId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Allow authenticated users to read employees
    match /employees/{employeeId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Allow authenticated users to read raw punches; only Director/HR can add, edit or delete
    match /rawPunches/{docId} {
      allow read: if request.auth != null;
      allow write: if canManagePunches();
    }

    // Allow authenticated users to read the punch audit log (change tracker); only Director/HR can write
    match /punchAuditLog/{docId} {
      allow read: if request.auth != null;
      allow write: if canManagePunches();
    }

    // Allow authenticated users to read shifts; only Director/HR may mutate valid slot documents
    match /shifts/{shiftId} {
      allow read: if request.auth != null;
      allow create, update: if canManageShifts()
        && request.resource.data.startTime is string
        && request.resource.data.endTime is string
        && request.resource.data.employees is list;
      allow delete: if canManageShifts();
    }

    // Allow authenticated users to read leaves; only Director/HR may mutate them
    match /leaves/{leaveId} {
      allow read: if request.auth != null;
      allow write: if canManageLeaves();
    }

    // Allow authenticated users to read leave limits; only Director/HR may mutate them
    match /leaveLimits/{limitId} {
      allow read: if request.auth != null;
      allow write: if canManageLeaves();
    }

    // Allow authenticated users to read and write week offs
    match /weekOffs/{weekOffId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Allow authenticated users to read and write devices
    match /devices/{deviceId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Allow authenticated users to read and write designations
    match /designations/{designationId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Allow authenticated users to read and write departments
    match /departments/{departmentId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Allow authenticated users to read and write branches
    match /branches/{branchId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Allow authenticated users to read and write enquiries
    match /enquiries/{enquiryId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Allow authenticated users to read and write users
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
